# DECISION TRAIL side file: a desktop diagnostic, rebuildable with
# `python explain_votes.py`, and 116 MB with kNN members in the spec --
# over GitHub's 100 MB hard limit. (CLAUDE.md section 12.)
models/gesture_panel.joblib

# Background training jobs: per-run logs and status (CLAUDE.md section 8m).
models/jobs/

# nn_ml_comb_test intermediates: per-model out-of-fold probabilities (~30 MB
# per run), regenerated by --resume. The report, CSVs and logs are kept.
models/comb_test/*/ml_oof/
models/comb_test_smoke/

# Claude Code agent worktrees (temporary checkouts)
.claude/worktrees/

# Raw out-of-fold probabilities of the ablation / zoo runs: regenerated by
# tools/ablation_*.py and training/train_zoo.py (the runs.jsonl files are kept)
results/**/*.npz
tests/last_run_partial.json
